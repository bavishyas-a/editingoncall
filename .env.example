# Jira (Atlassian API token: https://id.atlassian.com/manage-profile/security/api-tokens)
JIRA_BASE_URL=https://aftershoot.atlassian.net
JIRA_EMAIL=you@aftershoot.com
JIRA_API_TOKEN=

# Intercom (Developer Hub → your app → Authentication → access token)
INTERCOM_TOKEN=

# PostHog (personal API key with query:read scope)
POSTHOG_HOST=https://us.posthog.com
POSTHOG_PROJECT_ID=
POSTHOG_API_KEY=

# Anthropic, for issue classification and summaries
ANTHROPIC_API_KEY=

# Where results are written. Any SQLAlchemy URL works, e.g.
# postgresql+psycopg2://user:pass@host:5432/analytics   or   sqlite:///oncall.db
DATABASE_URL=sqlite:///oncall.db
